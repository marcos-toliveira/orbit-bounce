; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be edited if you have a clear idea of what you are doing.

config_version=5

[application]

config/name="Orbit Bounce"
config/description="Mobile 2D circular pong game developed in Godot 4"
run/main_scene="res://Main.tscn"
config/icon="res://assets/icons/icon_192.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.07, 0.11, 1)
boot_splash/image="res://assets/icons/splash_screen.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
